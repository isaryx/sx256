#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/reset.h>

/* Shorthand */
#define BASE 0
#define FN1 1
#define FN2 2
#define FN3 3

#define BT(n) &bt BT_SEL n
#define BT_CLEAR &bt BT_CLR
#define BT_BLE &out OUT_BLE

#define VOL_UP &kp C_VOL_UP
#define VOL_DN &kp C_VOL_DN
#define PLAY &kp C_PP
#define NEXT &kp C_NEXT
#define PREV &kp C_PREV

/* Simple Macros */
#define T_H &kp LC(A)
#define T_WB &kp LC(LEFT)
#define T_WF &kp LC(RIGHT)
#define T_E &kp LC(E)

#define CMD_R &kp LG(R)
#define CMD_F &kp LG(F)
#define CMD_T &kp LG(T)
#define CMD_B &kp LG(B)

/ {
  keymap {
    compatible = "zmk,keymap";

    Base_layer {
      bindings = <
        &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp BSPC
        &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp MINUS
        &kp TAB     &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
        &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH   &kp RSHFT
        &kp LCTRL   &kp LALT    &kp LEFT    &kp RIGHT   &mo FN1     &kp LGUI    &kp SPACE   &mo FN2     &kp DOWN    &kp RGUI    &kp RALT    &kp RCTRL
      >;
    };

    fn1_layer {
      bindings = <
        &kp GRAVE   &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp DEL
        &kp CAPS    &kp K_MUTE  &kp UP      &trans      CMD_R       CMD_T       PREV        PLAY        NEXT        &kp LBKT    &kp RBKT    &kp BSLH
        &kp CAPS    &kp LEFT    &kp DOWN    &kp RIGHT   CMD_T       &trans      &kp GRAVE   &kp EQUAL   &kp MINUS   &kp F7      &kp F8      &kp F9
        &trans      &trans      &trans      &trans      &trans      CMD_B       &kp F11     &kp F12     VOL_UP      VOL_DN      &kp UP      &trans
        &trans      &trans      &trans      &trans      &trans      &kp RETURN  &kp RETURN  &trans      &kp UP      &kp LEFT    &kp DOWN    &kp RIGHT
      >;
    };

    fn2_layer {
      bindings = <
        &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11     &kp F12
        &kp CAPS    &kp K_MUTE  &kp PG_UP   &trans      &trans      &trans      PREV        PLAY        NEXT        &kp LBKT    &kp RBKT    &kp BSLH
        &kp CAPS    &kp HOME    &kp PG_DOWN &kp END     &kp EQUAL   &kp MINUS   &kp GRAVE   &kp EQUAL   &kp MINUS   &kp F7      &kp F8      &kp F9
        &trans      &trans      &trans      &trans      &trans      &kp GRAVE   &kp F11     &kp F12     VOL_UP      VOL_DN      &kp UP      &trans
        &trans      &trans      &trans      &trans      &mo FN3     &kp RETURN  &kp RETURN  &trans      &kp UP      &kp LEFT    &kp DOWN    &kp RIGHT
      >;
    };

    fn3_layer {
      bindings = <
        BT_CLEAR    BT(0)       BT(1)       BT(2)       BT(3)       BT(4)       &none       &none       &none       &none       &none       &none
        BT_BLE      &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none
        &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none
        &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none
        &bootloader &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &bootloader
      >;
    };

  };
};